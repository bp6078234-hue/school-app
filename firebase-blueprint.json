{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile with role-based permissions",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    },
    "admission": {
      "title": "Admission",
      "description": "Student official admission application corresponding to the 4-page paper form",
      "type": "object",
      "properties": {
        "applicationId": { "type": "string", "maxLength": 30 },
        "userId": { "type": "string", "maxLength": 128 },
        "academicSession": { "type": "string", "maxLength": 20 },
        "targetClass": { "type": "string", "enum": ["9", "10", "11", "12"] },
        "status": { "type": "string", "enum": ["draft", "submitted", "under_review", "approved", "rejected", "action_required"] },
        "teacherRemarks": { "type": "string", "maxLength": 1000 },
        "submittedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["applicationId", "userId", "targetClass", "status"]
    },
    "quiz": {
      "title": "Quiz",
      "description": "Class and subject-specific daily quiz with multiple-choice questions",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "class": { "type": "string", "enum": ["9", "10", "11", "12"] },
        "subject": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "date": { "type": "string", "maxLength": 20 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "class", "subject", "status"]
    },
    "notification": {
      "title": "Notification",
      "description": "Status and system notifications for students and teachers",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["admission_submitted", "status_update", "new_quiz"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["recipientUid", "title", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "entities/user" },
      "description": "Stores user roles and profiles"
    },
    "/admissions/{admissionId}": {
      "schema": { "$ref": "entities/admission" },
      "description": "Stores all student admission applications and uploaded verification documents"
    },
    "/quizzes/{quizId}": {
      "schema": { "$ref": "entities/quiz" },
      "description": "Stores quizzes created by teachers or generated by AI"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "entities/notification" },
      "description": "Stores notifications for users"
    }
  }
}
